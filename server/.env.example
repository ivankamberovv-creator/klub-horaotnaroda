# Настройки на сървъра на клуба. Копирайте като .env на сървъра и попълнете; самият .env не се качва в хранилището.

PORT=4100
HOST=127.0.0.1
DB_PATH=/var/lib/klub/klub.db

# Парола за управлението (поне 12 знака) и ПИН за касите (поне 6 знака). Трябва да са различни.
ADMIN_PASSWORD=
KASA_PIN=

# Колко точки носи всяко цяло евро
POINTS_PER_EURO=1

# Точки подарък с първата покупка и на рождения ден; 0 ги изключва
WELCOME_POINTS=0
BIRTHDAY_POINTS=0

# Талони за изтриване след покупка: от каква сума нагоре и какво може да се падне („точки:тежест“).
# Празно SCRATCH_PRIZES = няма талони. Пример: 5 точки се падат най-често, 50 най-рядко.
# SCRATCH_MIN_EURO=5
# SCRATCH_PRIZES=5:55,10:30,20:12,50:3

# Къде се пазят качените снимки (по подразбиране: папка uploads до базата) и къде е готовото приложение
# UPLOAD_DIR=/var/lib/klub/uploads
# APP_DIR=/opt/klub/app/dist

# Първите две цифри на кода на клиента. 20–29 са баркодове за вътрешна употреба.
CARD_PREFIX=29

# Касата: demo (покупките се въвеждат на ръка от страницата „Каса“) или yanak (още не е довършена)
KASA=demo
# YANAK_EMAIL=
# YANAK_USERNAME=

# Писмата с кода за вход. smtp ги праща през пощенска кутия на клуба (отделна от тази на сайта);
# demo само ги печата и върви единствено с DEMO=1.
# Домейнът на кутията трябва да има записи SPF и DKIM, иначе писмата отиват в „Спам“.
MAIL_PROVIDER=smtp
SMTP_HOST=
# 465 е с шифроване от самото начало; на 587 връзката се шифрова със STARTTLS
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Клуб „Хора от Народа“ <klub@primer.bg>

# 1, когато сървърът е зад nginx (за да вижда истинския адрес на посетителя)
TRUST_PROXY=1
